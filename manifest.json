{
  "name": "Ajax Modifier",
  "version": "1.5.7.10",
  "version_name": "1.5.7(10)",
  "description": "To modify ajax responses on any page",
  "permissions": [
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "icons": {
    "16": "images/16_gray.png",
    "32": "images/32_gray.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "manifest_version": 3,
  "web_accessible_resources": [
    {
      "resources": [
        "pageScripts/defaultSettings.js",
        "pageScripts/mockjs.js",
        "pageScripts/main.js",
        "iframe/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "点击打开面板"
  },
  "content_security_policy": {},
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "devtools_page": "devtools.html"
}
